# build artifacts
public/
resources/
.hugo_build.lock
.qmd/
.awiki/*
!.awiki/.gitkeep
!.awiki/config

# inbox: source files often sensitive / copyrighted
raw/inbox/*
!raw/inbox/interactive/.gitkeep
!raw/inbox/batch/.gitkeep
!raw/inbox/checkpoint/.gitkeep

# default-private until user opts in via BOOTSTRAP / encrypt-init
raw/processed/*
!raw/processed/.gitkeep
content/private/**
raw/processed/private/**
raw/processed/_originals/**

# secrets — deny all, allow only public keys
secrets/**
!secrets/*.pub

# obsidian local state
.obsidian/workspace*
.obsidian/cache

# OS / editor
.DS_Store
*.swp
*.swo
__pycache__/
*.pyc

# === phase 13: synthesis ===
content/synthesis/.staged/*
!content/synthesis/.staged/.gitkeep

# === phase 16: task layer ===
.awiki/lock
.awiki/last-review
.awiki/task-count
.awiki/maps/

# git-docs ingest (phase 20)
.awiki/git-state/
.awiki/lock/
raw/_git-cache/

# === git worktrees ===
.worktrees/

# phase-17 spike vault — Obsidian config is per-machine
tests/fixtures/spike-obsidian-vault/.obsidian/

# template-update cache (gitignored; rebuildable from template.json pin)
.awiki/template-cache/
